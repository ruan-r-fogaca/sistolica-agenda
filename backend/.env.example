# Porta em que a API vai rodar
PORT=4000

# Chave da API do Gemini (Google AI Studio -> aistudio.google.com/apikey)
# Sem essa chave, o app continua funcionando, mas a sugestão da IA
# cai automaticamente no modo heurístico (fallback), sem inteligência real.
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo do Gemini usado nas sugestões
GEMINI_MODEL=gemini-2.5-flash

# --- Integração real com Google Sheets (opcional) ---
# Sem essas duas variáveis, o app usa o modo simulado (src/data/db.json).
# Passo a passo completo de como preencher: veja o README.md, seção
# "Integração real com Google Sheets".

# ID da planilha (está na URL do Google Sheets, entre /d/ e /edit)
GOOGLE_SHEET_ID=

# Conteúdo do arquivo JSON da service account, convertido para base64 (uma linha só)
GOOGLE_SERVICE_ACCOUNT_B64=
